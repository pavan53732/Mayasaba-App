<Window
    x:Class="Mayasaba.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootLayout" Background="{ThemeResource MayasabaCanvasBrush}" SizeChanged="OnRootSizeChanged">
        <!-- Ambient hero loops are not declared here. MotionController owns them so the
             documented durations have a single source (MotionTokens) and every loop is
             stopped by the same lifecycle path as the finite transitions. -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File is a native WinUI MenuBar outside Chat content. Never put a folder control in Chat. -->
        <MenuBar x:Name="NativeFileMenu" Visibility="Collapsed" Grid.Row="0"
                 Background="{ThemeResource MayasabaPanelBrush}"
                 HorizontalAlignment="Stretch" Padding="12,2">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Switch Project" Click="OnSwitchProject"/>
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">

            <!-- ==========================================================================
                 SCREEN 1 — WELCOME
                 Presentation only. Intentionally NO composer. KeyDown is scoped to this
                 screen so Escape means "skip the explanation" here and keeps its own meaning
                 everywhere else (Chat, flyouts, dialogs, the native folder picker).
                 The action footer lives OUTSIDE the scrollable body, so Next and Skip stay
                 reachable at every window height.
                 ========================================================================== -->
            <Grid x:Name="WelcomeScreen" Visibility="Collapsed" KeyDown="OnWelcomeKeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand bar: identity plus the three named CLI readiness entries. -->
                <Grid x:Name="WelcomeTopBar" Grid.Row="0" Padding="28,18,28,6" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mayasaba" FontFamily="Segoe UI Variable Display" FontSize="17"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource MayasabaInkBrush}"/>
                    <StackPanel x:Name="WelcomeReadinessPanel" Grid.Column="1" Orientation="Horizontal"
                                Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                AutomationProperties.Name="CLI readiness">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource MayasabaAmberBrush}"/>
                            <TextBlock x:Name="WelcomeHermesStatus" Text="Hermes Agent CLI · UNSUPPORTED"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource MayasabaMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource MayasabaAmberBrush}"/>
                            <TextBlock x:Name="WelcomeKiloStatus" Text="Kilo Code CLI · UNSUPPORTED"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource MayasabaMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource MayasabaAmberBrush}"/>
                            <TextBlock x:Name="WelcomeClaudeStatus" Text="Claude Code CLI · UNSUPPORTED"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource MayasabaMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="WelcomeBodyScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="40,8,40,20">
                        <StackPanel x:Name="WelcomeStack" MaxWidth="840" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="16">

                            <!-- Native dimensional brand hero: layered edges, perspective, and a
                                 bounded pointer tilt. The glow and orbit rings are decorative and
                                 are removed entirely in high contrast. -->
                            <Grid x:Name="WelcomeHeroStage" Width="252" Height="226"
                                  HorizontalAlignment="Left"
                                  PointerMoved="OnHeroPointerMoved"
                                  PointerExited="OnHeroPointerExited"
                                  PointerCanceled="OnHeroPointerExited"
                                  AutomationProperties.Name="Mayasaba mark">
                                <Grid.Transform3D>
                                    <PerspectiveTransform3D Depth="900"/>
                                </Grid.Transform3D>
                                <Ellipse x:Name="WelcomeHeroGlow" Width="230" Height="176"
                                         Fill="{ThemeResource MayasabaAmbientGlowBrush}" Opacity="0.5"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="WelcomeHeroGlowTransform"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="WelcomeHeroOrbitOuter" Width="198" Height="198"
                                         Stroke="{ThemeResource MayasabaBorderBrush}" StrokeThickness="1"
                                         StrokeDashArray="3,4" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="WelcomeHeroOrbitOuterRotate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="WelcomeHeroOrbitInner" Width="156" Height="156"
                                         Stroke="{ThemeResource MayasabaBorderBrush}" StrokeThickness="1"
                                         StrokeDashArray="3,4" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="WelcomeHeroOrbitInnerRotate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Contact shadow: the sculpture has to rest on something. Painted
                                     before the mark, removed with every other decorative cue. -->
                                <Ellipse x:Name="WelcomeHeroContactShadow" Width="168" Height="32"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                         Margin="0,0,0,10"
                                         Fill="{ThemeResource MayasabaContactShadowBrush}"/>

                                <Grid x:Name="WelcomeHeroMark" Width="138" Height="138"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.Transform3D>
                                        <CompositeTransform3D x:Name="WelcomeHeroTilt" RotationX="15" RotationY="-22" RotationZ="-9"/>
                                    </Grid.Transform3D>
                                    <!-- Real extruded slices: every edge sits at a negative Z behind the
                                         face under the stage perspective, so the mark is genuinely
                                         three-dimensional rather than an offset outline. Decorative
                                         depth only; collapsed in high contrast and never a carrier
                                         of meaning. -->
                                    <Border x:Name="WelcomeHeroLayer3" Width="92" Height="92"
                                            CornerRadius="27" Translation="10,12,-34"
                                            Background="{ThemeResource MayasabaDepthEdgeBrush}" Opacity="0.20"/>
                                    <Border x:Name="WelcomeHeroLayer2" Width="92" Height="92"
                                            CornerRadius="27" Translation="6,7,-18"
                                            Background="{ThemeResource MayasabaDepthEdgeBrush}" Opacity="0.36"/>
                                    <Border x:Name="WelcomeHeroLayer1" Width="92" Height="92"
                                            CornerRadius="27" Translation="3,3,-7"
                                            Background="{ThemeResource MayasabaDepthEdgeBrush}" Opacity="0.52"/>
                                    <Border x:Name="WelcomeHeroCore" Width="92" Height="92" CornerRadius="27"
                                            Background="{ThemeResource MayasabaBrandGradientBrush}">
                                        <Border.RenderTransform>
                                            <CompositeTransform x:Name="WelcomeHeroCoreTransform" Rotation="-8"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <!-- Restrained top-left key light so the face reads as a solid.
                                                 Dropped entirely in high contrast. -->
                                            <Border x:Name="WelcomeHeroFaceLight" CornerRadius="27"
                                                    Background="{ThemeResource MayasabaFaceLightBrush}"/>
                                            <Viewbox Margin="13">
                                                <Canvas Width="72" Height="72">
                                                    <Canvas.RenderTransform>
                                                        <RotateTransform x:Name="WelcomeHeroGlyphRotate" Angle="8"/>
                                                    </Canvas.RenderTransform>
                                                    <Path Data="M14,48 L14,25 C14,17 20,15 26,19 L36,26 L46,19 C52,15 58,17 58,25 L58,48"
                                                          Stroke="White" StrokeThickness="7" StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Ellipse Width="10" Height="10" Canvas.Left="11" Canvas.Top="48" Fill="White"/>
                                                    <Ellipse Width="10" Height="10" Canvas.Left="31" Canvas.Top="29" Fill="White"/>
                                                    <Ellipse Width="10" Height="10" Canvas.Left="51" Canvas.Top="48" Fill="White"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <StackPanel x:Name="WelcomeMessageBlock" Spacing="14">
                                <TextBlock Text="THREE PERSPECTIVES · ONE CLEAR DIRECTION"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{ThemeResource MayasabaBrandBrush}"/>
                                <TextBlock x:Name="WelcomeHeading" Text="Welcome to Mayasaba"
                                           Style="{StaticResource MayasabaHeroText}"
                                           MaxWidth="840"
                                           AutomationProperties.HeadingLevel="Level1"/>
                                <TextBlock FontSize="18" Foreground="{ThemeResource MayasabaMutedBrush}"
                                           TextWrapping="Wrap" MaxWidth="700"
                                           Text="A calm Windows control room for Hermes Agent CLI, Kilo Code CLI and Claude Code CLI. Inspect their work, preserve evidence and stay in control of every material action."/>
                                <Border Style="{StaticResource MayasabaSecondarySurface}" CornerRadius="12" Padding="14,10" MaxWidth="640">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xEA18;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                  Foreground="{ThemeResource MayasabaBrandBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="You install and sign in to the three CLIs yourself. Mayasaba never installs a model, changes your provider or starts a CLI merely because you opened a folder. A missing CLI never blocks opening a folder."
                                                   FontSize="13" Foreground="{ThemeResource MayasabaMutedBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="580"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Stable per-CLI monogram identity: name plus colour, never colour alone. -->
                            <StackPanel x:Name="WelcomeMonogramPanel" Orientation="Horizontal" Spacing="10"
                                        Margin="0,4,0,0">
                                <Border Style="{StaticResource MayasabaSecondarySurface}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="22" Height="22" CornerRadius="7"
                                                Background="{ThemeResource MayasabaHermesMonogramBrush}">
                                            <TextBlock Text="H" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource MayasabaHermesInkBrush}"/>
                                        </Border>
                                        <TextBlock Text="Hermes Agent CLI" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource MayasabaMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MayasabaSecondarySurface}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="22" Height="22" CornerRadius="7"
                                                Background="{ThemeResource MayasabaKiloMonogramBrush}">
                                            <TextBlock Text="K" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource MayasabaKiloInkBrush}"/>
                                        </Border>
                                        <TextBlock Text="Kilo Code CLI" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource MayasabaMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MayasabaSecondarySurface}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="22" Height="22" CornerRadius="7"
                                                Background="{ThemeResource MayasabaClaudeMonogramBrush}">
                                            <TextBlock Text="C" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource MayasabaClaudeInkBrush}"/>
                                        </Border>
                                        <TextBlock Text="Claude Code CLI" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource MayasabaMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock MaxWidth="720" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{ThemeResource MayasabaSoftBrush}"
                                       Text="Native capability probes are not implemented in this build, so each CLI is reported as UNSUPPORTED rather than guessed. Folder selection and Chat are unaffected."/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Action footer: always visible, never scrolled away. -->
                <Border x:Name="WelcomeFooter" Grid.Row="2" Background="{ThemeResource MayasabaWindowBrush}"
                        BorderBrush="{ThemeResource MayasabaBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="28,14,28,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WelcomeFooterHint" VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource MayasabaMutedBrush}"
                                   Text="Escape does the same as Skip. It cannot reach Chat without a bound project."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SkipButton" Click="OnWelcomeNext" Content="Skip introduction"
                                    Style="{StaticResource MayasabaSecondaryAction}"
                                    AutomationProperties.Name="Skip the introduction"/>
                            <Button x:Name="NextButton" Click="OnWelcomeNext" Content="Next →"
                                    Style="{StaticResource MayasabaPrimaryAction}"
                                    AutomationProperties.Name="Continue to project selection"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==========================================================================
                 SCREEN 2 — PROJECT SELECTION
                 The reusable project selector. Its readiness region is a persistent header,
                 not something scrolled to. All Screen 2 safety behavior is unchanged.
                 ========================================================================== -->
            <Grid x:Name="FolderScreen" Visibility="Collapsed" KeyDown="OnFolderKeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Persistent header: contextual exit action plus CLI readiness. -->
                <Border Grid.Row="0" Background="{ThemeResource MayasabaWindowBrush}"
                        BorderBrush="{ThemeResource MayasabaBorderBrush}" BorderThickness="0,0,0,1"
                        Padding="24,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FolderBackButton" Click="OnWelcomeBack" Content="← Back"
                                Padding="14,7" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                Visibility="Collapsed" AutomationProperties.Name="Back to the introduction"/>
                        <Button x:Name="FolderExitButton" Click="OnExit" Content="Exit"
                                Padding="14,7" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                Visibility="Collapsed" AutomationProperties.Name="Exit Mayasaba"/>
                        <Button x:Name="FolderCancelButton" Click="OnCancelSwitch" Content="Cancel"
                                Padding="14,7" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                Visibility="Collapsed" AutomationProperties.Name="Cancel switching projects"/>
                        <TextBlock x:Name="FolderWordmark" Grid.Column="1" Text="Mayasaba"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{ThemeResource MayasabaInkBrush}"/>
                        <StackPanel x:Name="FolderReadinessPanel" Grid.Column="2" Orientation="Horizontal"
                                    Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    AutomationProperties.Name="CLI readiness">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource MayasabaAmberBrush}"/>
                                <TextBlock Text="Hermes Agent CLI · UNSUPPORTED" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource MayasabaMutedBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource MayasabaAmberBrush}"/>
                                <TextBlock Text="Kilo Code CLI · UNSUPPORTED" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource MayasabaMutedBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource MayasabaAmberBrush}"/>
                                <TextBlock Text="Claude Code CLI · UNSUPPORTED" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource MayasabaMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="FolderBodyScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="32,22,32,36">
                        <StackPanel x:Name="FolderStack" HorizontalAlignment="Center"
                                    MaxWidth="780" Spacing="18">

                            <Grid ColumnSpacing="16" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="FolderHeading" Text="Pick up where you left off"
                                               Style="{StaticResource MayasabaScreenTitleText}"
                                               AutomationProperties.HeadingLevel="Level1"/>
                                    <TextBlock Text="Select a recent project, open an existing folder, or create a new project folder. Opening a folder only creates or restores project identity: it launches no CLI session, scans nothing, initializes no Git repository and installs nothing."
                                               Style="{StaticResource MayasabaBodyText}"
                                               Foreground="{ThemeResource MayasabaMutedBrush}" MaxWidth="620"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="64" Height="64" CornerRadius="18"
                                        Background="{ThemeResource MayasabaSecondaryBrush}"
                                        BorderBrush="{ThemeResource MayasabaPlateEdgeBrush}" BorderThickness="1"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <FontIcon Glyph="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="28"
                                              Foreground="{ThemeResource MayasabaBrandBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Primary folder actions. These stack vertically so neither can be
                                 pushed off a narrow window. -->
                            <StackPanel Spacing="10">
                                <Button x:Name="ChooseFolderButton" Click="OnChooseFolder"
                                        Style="{StaticResource MayasabaPrimaryAction}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Open an existing project folder">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                        <TextBlock Text="Open Existing Folder" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CreateNewProjectButton" Click="OnToggleCreateFolder"
                                        Style="{StaticResource MayasabaSecondaryAction}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Create a new project folder">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8F4;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                        <TextBlock Text="Create New Project Folder" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Inline Create Folder Panel (collapsible, animated with Appear) -->
                            <Border x:Name="CreateFolderPanel" Visibility="Collapsed"
                                    Style="{StaticResource MayasabaCardSurface}" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Create a new project folder"
                                               Style="{StaticResource MayasabaSectionText}"
                                               AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="Select an existing parent directory and enter a folder name. Only this single empty directory will be created."
                                               Style="{StaticResource MayasabaMetaText}"/>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Parent location" Style="{StaticResource MayasabaMicroText}"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ParentLocationBox" IsReadOnly="True"
                                                     PlaceholderText="Select a parent folder..."
                                                     AutomationProperties.Name="Parent location"/>
                                            <Button Grid.Column="1" Click="OnBrowseParentFolder" Content="Browse…"
                                                    Padding="16,8" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                                    AutomationProperties.Name="Browse for a parent folder"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="New folder name" Style="{StaticResource MayasabaMicroText}"/>
                                        <TextBox x:Name="NewFolderNameBox" PlaceholderText="e.g. my-project"
                                                 TextChanged="OnNewFolderNameChanged"
                                                 AutomationProperties.Name="New folder name"/>
                                        <TextBlock x:Name="TargetPathPreview" Style="{StaticResource MayasabaTechnicalText}"/>
                                        <TextBlock x:Name="CreateFolderError" FontSize="12"
                                                   Foreground="{ThemeResource MayasabaDangerBrush}"
                                                   Visibility="Collapsed" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Assertive"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button Click="OnCancelCreateFolder" Content="Cancel" Padding="16,8"
                                                CornerRadius="{StaticResource MayasabaRadiusControl}"/>
                                        <Button x:Name="CreateAndOpenButton" Click="OnCreateAndOpenFolder"
                                                Content="Create and Open" IsEnabled="False"
                                                Style="{StaticResource MayasabaPrimaryAction}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Draft Collision Panel (collapsible, animated with Appear) -->
                            <Border x:Name="DraftCollisionPanel" Visibility="Collapsed"
                                    BorderBrush="{ThemeResource MayasabaAmberBrush}" BorderThickness="1.5"
                                    Background="{ThemeResource MayasabaPanelBrush}"
                                    CornerRadius="{StaticResource MayasabaRadiusPanel}" Padding="20">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons"
                                                  Foreground="{ThemeResource MayasabaAmberBrush}"/>
                                        <TextBlock Text="Draft conflict" Style="{StaticResource MayasabaSectionText}"
                                                   AutomationProperties.HeadingLevel="Level2"/>
                                    </StackPanel>
                                    <TextBlock Text="Both drafts are preserved. Keep the project draft, or move the selector draft into Chat and keep the old project draft here. An unresolved submission cannot be replaced."
                                               Style="{StaticResource MayasabaMetaText}"/>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Existing project draft" Style="{StaticResource MayasabaMicroText}"/>
                                            <TextBox x:Name="TargetDraftPreviewBox" IsReadOnly="True"
                                                     TextWrapping="Wrap" MaxHeight="100" AcceptsReturn="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Selector pre-binding draft" Style="{StaticResource MayasabaMicroText}"/>
                                            <TextBox x:Name="PrebindDraftPreviewBox" IsReadOnly="True"
                                                     TextWrapping="Wrap" MaxHeight="100" AcceptsReturn="True"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="10" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                        <Button Click="OnCancelDraftCollision" Content="Cancel" Padding="16,8"
                                                CornerRadius="{StaticResource MayasabaRadiusControl}"/>
                                        <Button x:Name="KeepTargetDraftButton" Click="OnKeepTargetDraft"
                                                Content="Keep project draft" Padding="16,8"
                                                CornerRadius="{StaticResource MayasabaRadiusControl}"/>
                                        <Button x:Name="UsePrebindDraftButton" Click="OnUsePrebindDraft"
                                                Content="Use selector draft"
                                                Style="{StaticResource MayasabaPrimaryAction}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Recent projects: the primary content of this screen. -->
                            <Border Style="{StaticResource MayasabaCardSurface}" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Recent projects" Style="{StaticResource MayasabaSectionText}"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.HeadingLevel="Level2"/>
                                        <TextBlock x:Name="RecentProjectsFilterCountLabel" Grid.Column="1"
                                                   Style="{StaticResource MayasabaMicroText}"
                                                   Foreground="{ThemeResource MayasabaMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Filter recent projects by name, path, or status -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RecentProjectsFilterBox"
                                                 PlaceholderText="Filter recent projects by name or path..."
                                                 TextChanged="OnRecentFilterTextChanged"
                                                 PreviewKeyDown="OnRecentFilterBoxKeyDown"
                                                 AutomationProperties.Name="Filter recent projects"/>
                                        <Button x:Name="RecentProjectsClearFilterButton" Grid.Column="1"
                                                Click="OnClearRecentFilter" Content="Clear" Visibility="Collapsed"
                                                Padding="12,6" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                                AutomationProperties.Name="Clear project filter"/>
                                        <ComboBox x:Name="RecentProjectsStatusFilter" Grid.Column="2"
                                                  SelectedIndex="0" SelectionChanged="OnRecentStatusFilterChanged"
                                                  CornerRadius="{StaticResource MayasabaRadiusControl}"
                                                  AutomationProperties.Name="Filter by project status">
                                            <ComboBoxItem Content="All projects"/>
                                            <ComboBoxItem Content="Open projects only"/>
                                            <ComboBoxItem Content="Closed projects only"/>
                                        </ComboBox>
                                    </Grid>

                                    <TextBlock x:Name="NoRecentProjectsText" Text="No recent projects yet."
                                               Style="{StaticResource MayasabaMetaText}"
                                               Visibility="Collapsed"/>
                                    <ListView x:Name="RecentProjectsList" SelectionMode="None" MaxHeight="380"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              HorizontalContentAlignment="Stretch"
                                              AutomationProperties.Name="Recent projects"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="PreviousRecentButton" Content="Previous projects"
                                                Click="OnRecentPrevious" IsEnabled="False" Padding="14,7"
                                                CornerRadius="{StaticResource MayasabaRadiusControl}"/>
                                        <Button x:Name="NextRecentButton" Content="Next projects"
                                                Click="OnRecentNext" IsEnabled="False" Padding="14,7"
                                                CornerRadius="{StaticResource MayasabaRadiusControl}"/>
                                    </StackPanel>
                                    <Button x:Name="RetryStoreButton" Content="Retry opening local store"
                                            Click="OnRetryStore" Visibility="Collapsed" Padding="14,7"
                                            CornerRadius="{StaticResource MayasabaRadiusControl}"/>
                                    <StackPanel x:Name="RecoveryList" Spacing="10"
                                                AutomationProperties.Name="Folder creation recovery"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ==========================================================================
                 SCREEN 3 — CHAT
                 The only persistent work surface. All other information is a Chat card.
                 ========================================================================== -->
            <Grid x:Name="ChatScreen" Visibility="Collapsed" KeyDown="OnChatKeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource MayasabaPanelBrush}"
                        BorderBrush="{ThemeResource MayasabaBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="22,14">
                    <Grid x:Name="ChatHeaderGrid" ColumnSpacing="14" RowSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="ChatHeaderIdentityPanel" ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="31" Height="31" CornerRadius="11"
                                    Background="{ThemeResource MayasabaBrandGradientBrush}"
                                    VerticalAlignment="Center">
                                <Viewbox Margin="5">
                                    <Canvas Width="72" Height="72">
                                        <Path Data="M14,48 L14,25 C14,17 20,15 26,19 L36,26 L46,19 C52,15 58,17 58,25 L58,48"
                                              Stroke="White" StrokeThickness="7" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="10" Height="10" Canvas.Left="11" Canvas.Top="48" Fill="White"/>
                                        <Ellipse Width="10" Height="10" Canvas.Left="31" Canvas.Top="29" Fill="White"/>
                                        <Ellipse Width="10" Height="10" Canvas.Left="51" Canvas.Top="48" Fill="White"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock x:Name="ProjectHeading" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource MayasabaInkBrush}" Text="Project"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           AutomationProperties.HeadingLevel="Level1"/>
                                <TextBlock x:Name="ProjectPathLabel" FontFamily="Cascadia Mono" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource MayasabaMutedBrush}" Text="C:\Projects"/>
                                <TextBlock x:Name="ProjectCondition" FontSize="11.5" Text="Not started" TextWrapping="Wrap"
                                           Foreground="{ThemeResource MayasabaMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Responsive layout: on wide screens, identity and controls share row 0;
                             on narrow screens (<760px), controls move to row 1 so project identity
                             never starves or collapses to 0 width. -->
                        <StackPanel x:Name="ChatHeaderActionsPanel" Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="SearchMessagesButton" Click="OnSearchMessagesClick"
                                    Padding="13,7" CornerRadius="11"
                                    AutomationProperties.Name="Search saved user messages"
                                    AutomationProperties.AcceleratorKey="Control F">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                    <TextBlock Text="Search"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StartButton" Content="Start" Click="OnStart" Padding="15,7"
                                    CornerRadius="11"
                                    AutomationProperties.HelpText="Starts all three project-scoped CLI sessions. Currently blocked because no native adapter exists."/>
                            <Button x:Name="PauseButton" Content="Pause" Click="OnPause" Padding="15,7" CornerRadius="11"/>
                            <Button x:Name="StopButton" Content="Stop" Click="OnStop" Padding="15,7" CornerRadius="11"
                                    AutomationProperties.HelpText="Immediate control. Never waits for an animation or a reply."/>
                            <Button x:Name="ReopenButton" Content="Reopen Project" Click="OnReopen"
                                    Visibility="Collapsed" CornerRadius="11" Padding="15,7"/>
                            <Button Content="•••" AutomationProperties.Name="More project actions"
                                    CornerRadius="11" Padding="13,7">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="CLI diagnostics" Click="OnDiagnostics"/>
                                        <MenuFlyoutItem Text="Close Project" Click="OnCloseProject"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ExitButton" Content="Exit" Click="OnExit" Padding="15,7"
                                    CornerRadius="11" AutomationProperties.Name="Exit Mayasaba"/>
                                                            </StackPanel>
                                                            <!-- Compact Action Center: read-only projection of unresolved owner obligations. -->
                                                            <Border x:Name="ActionCenterPanel" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed"
                                                                    Style="{StaticResource MayasabaCardSurface}" Padding="12"
                                                                    BorderBrush="{ThemeResource MayasabaAmberBrush}" BorderThickness="1"
                                                                    AutomationProperties.AutomationId="ActionCenterPanel"
                                                                    AutomationProperties.Name="Action Center" AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0">
                                                                <StackPanel Spacing="8">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                            <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                                                      Foreground="{ThemeResource MayasabaBrandBrush}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="Needs your attention" Style="{StaticResource MayasabaSectionText}"
                                                                                       AutomationProperties.HeadingLevel="Level3"/>
                                                                        </StackPanel>
                                                                        <Button x:Name="CloseActionCenterButton" Grid.Column="1" Click="OnCloseActionCenter"
                                                                                Padding="8,6" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                                                                AutomationProperties.Name="Close Action Center">
                                                                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                                                        </Button>
                                                                    </Grid>
                                                                    <TextBlock x:Name="ActionCenterStatusText" Text="Checking owner records..."
                                                                               Style="{StaticResource MayasabaMicroText}"
                                                                               Foreground="{ThemeResource MayasabaMutedBrush}"
                                                                               AutomationProperties.LiveSetting="Polite"/>
                                                                    <ListView x:Name="ActionCenterList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnActionCenterItemClick" MaxHeight="220"
                                                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                AutomationProperties.Name="Action Center items"/>
                                                                    <Button x:Name="ShowActionCenterDetailsButton" Content="Show details" Visibility="Collapsed"
                                                                            Click="OnShowActionCenterDetails" Padding="14,7"
                                                                            HorizontalAlignment="Left" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                                                            AutomationProperties.Name="Show Action Center details"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <StackPanel x:Name="ChatReadinessPanel" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="15"
                                                                        HorizontalAlignment="Right" AutomationProperties.Name="CLI readiness">
                                                                <TextBlock x:Name="HermesStatus" FontSize="11.5"
                                                                           Text="Hermes Agent CLI · UNSUPPORTED"/>
                                                                <TextBlock x:Name="KiloStatus" FontSize="11.5"
                                                                           Text="Kilo Code CLI · UNSUPPORTED"/>
                                                                <TextBlock x:Name="ClaudeStatus" FontSize="11.5"
                                                                           Text="Claude Code CLI · UNSUPPORTED"/>
                                                            </StackPanel>
                                                        </Grid>
                        </Border>

                <!-- The conversation area and the ONE composer.
                     Four auto/star rows replace the previous independent 190/135 fixed offsets:
                       empty state  -> [*] [hero] [composer] [*]   (hero + composer are one centred group)
                       docked state -> [*] [0]    [composer] [0]   (composer pinned under the timeline)
                     No critical control can therefore be pushed off a short window. -->
                <Grid x:Name="ChatBody" Grid.Row="1" SizeChanged="OnChatBodySizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ChatTopSpacer" Height="*"/>
                        <RowDefinition x:Name="ChatHeroRow" Height="Auto"/>
                        <RowDefinition x:Name="ChatComposerRow" Height="Auto"/>
                        <RowDefinition x:Name="ChatBottomSpacer" Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Temporary Search Messages Panel (animated reveal) -->
                    <Border x:Name="MessageSearchPanel" Grid.Row="0" Grid.RowSpan="4"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            MaxWidth="760" Margin="18,10,18,0"
                            Visibility="Collapsed" Canvas.ZIndex="20"
                            Style="{StaticResource MayasabaCardSurface}"
                            Padding="16"
                            BorderBrush="{ThemeResource MayasabaBrandBrush}" BorderThickness="1.5">
                        <StackPanel Spacing="10">
                            <!-- Search header row -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                              Foreground="{ThemeResource MayasabaBrandBrush}"/>
                                    <TextBlock Text="Search saved user messages" Style="{StaticResource MayasabaSectionText}"
                                               AutomationProperties.HeadingLevel="Level2"/>
                                </StackPanel>
                                <Button x:Name="CloseSearchButton" Grid.Column="1" Click="OnCloseSearch"
                                        Padding="10,6" CornerRadius="{StaticResource MayasabaRadiusControl}"
                                        AutomationProperties.Name="Close search overlay (Escape)">
                                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                </Button>
                            </Grid>

                            <!-- Query input row -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MessageSearchBox"
                                         PlaceholderText="Search saved user messages in this project..."
                                         TextChanged="OnSearchQueryChanged"
                                         PreviewKeyDown="OnSearchBoxKeyDown"
                                         AutomationProperties.Name="Search query input"/>
                                <Button x:Name="ClearSearchButton" Grid.Column="1" Click="OnClearSearchQuery"
                                         Content="Clear" Visibility="Collapsed" Padding="12,6"
                                         CornerRadius="{StaticResource MayasabaRadiusControl}"
                                         AutomationProperties.Name="Clear search query"/>
                            </Grid>

                            <!-- Search status label -->
                            <TextBlock x:Name="SearchStatusText" Text="Type a query to search confirmed saved user messages."
                                       Style="{StaticResource MayasabaMicroText}"
                                       Foreground="{ThemeResource MayasabaMutedBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>

                            <!-- Search results list -->
                            <ListView x:Name="SearchResultsList" MaxHeight="280"
                                      SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnSearchResultItemClick"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="Search results"/>

                            <!-- Load more button -->
                            <Button x:Name="SearchLoadMoreButton" Click="OnSearchLoadMore"
                                    Content="Load more results" Visibility="Collapsed"
                                    HorizontalAlignment="Center" Padding="14,6"
                                    CornerRadius="{StaticResource MayasabaRadiusControl}"
                                    AutomationProperties.Name="Load more matching messages"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="HistoryScroller" Grid.Row="0" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  VerticalAnchorRatio="1.0"
                                  ViewChanged="OnHistoryViewChanged">
                        <ItemsRepeater x:Name="HistoryRepeater" Margin="0,20,0,10"
                                       HorizontalAlignment="Center"
                                       AutomationProperties.Name="Conversation timeline">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="16"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Truthful unseen-entry count. Shown only when the reader is not at the end. -->
                    <Button x:Name="JumpToLatestButton" Grid.Row="0" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,16"
                            Click="OnJumpToLatest" Padding="14,8"
                            CornerRadius="{StaticResource MayasabaRadiusControl}"
                            AutomationProperties.Name="Jump to the latest entry"/>

                    <!-- Empty-state hero. Its decorative art is removed before the composer can be
                         pushed off a short window; the invitation text always remains. -->
                    <StackPanel x:Name="EmptyChatHero" Grid.Row="1" HorizontalAlignment="Center"
                                Spacing="12" Margin="24,0,24,20">
                        <Grid x:Name="EmptyHeroArt" Width="176" Height="146" HorizontalAlignment="Center">
                            <Grid.Transform3D>
                                <PerspectiveTransform3D Depth="900"/>
                            </Grid.Transform3D>
                            <Ellipse x:Name="EmptyChatGlow" Width="176" Height="130"
                                     Fill="{ThemeResource MayasabaAmbientGlowBrush}" Opacity="0.45"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="EmptyHeroGlowTransform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="EmptyHeroContactShadow" Width="112" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Margin="0,0,0,6"
                                     Fill="{ThemeResource MayasabaContactShadowBrush}"/>
                            <Grid x:Name="EmptyHeroMark" Width="96" Height="96"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="EmptyHeroLevitate"/>
                                </Grid.RenderTransform>
                                <Grid.Transform3D>
                                    <CompositeTransform3D x:Name="EmptyHeroTilt" RotationX="15" RotationY="-22" RotationZ="-9"/>
                                </Grid.Transform3D>
                                <Border x:Name="EmptyHeroLayer1" Width="76" Height="76" CornerRadius="24"
                                        Translation="8,9,-26"
                                        Background="{ThemeResource MayasabaDepthEdgeBrush}" Opacity="0.30"/>
                                <Border x:Name="EmptyHeroLayer2" Width="76" Height="76" CornerRadius="24"
                                        Translation="4,4,-12"
                                        Background="{ThemeResource MayasabaDepthEdgeBrush}" Opacity="0.52"/>
                                <Border Width="76" Height="76" CornerRadius="24"
                                        Background="{ThemeResource MayasabaBrandGradientBrush}">
                                    <Grid>
                                        <Border x:Name="EmptyHeroFaceLight" CornerRadius="24"
                                                Background="{ThemeResource MayasabaFaceLightBrush}"/>
                                        <Viewbox Margin="11">
                                            <Canvas Width="72" Height="72">
                                                <Path Data="M14,48 L14,25 C14,17 20,15 26,19 L36,26 L46,19 C52,15 58,17 58,25 L58,48"
                                                      Stroke="White" StrokeThickness="7" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Ellipse Width="10" Height="10" Canvas.Left="11" Canvas.Top="48" Fill="White"/>
                                                <Ellipse Width="10" Height="10" Canvas.Left="31" Canvas.Top="29" Fill="White"/>
                                                <Ellipse Width="10" Height="10" Canvas.Left="51" Canvas.Top="48" Fill="White"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="EmptyChatHeading" Text="What would you like to work on?"
                                   FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                                   Foreground="{ThemeResource MayasabaInkBrush}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock x:Name="EmptyChatHint"
                                   Text="Every saved message is independent of CLI readiness. Agent replies are unavailable in this build because no native adapter is implemented."
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                                   Foreground="{ThemeResource MayasabaMutedBrush}" FontSize="13"/>
                    </StackPanel>

                    <!-- The ONE Chat composer. It never moves between parents, so its text,
                         caret, selection, prepared attachments and focus survive the Dock. -->
                    <StackPanel x:Name="ComposerHost" Grid.Row="2" Margin="18,0,18,16"
                                HorizontalAlignment="Stretch">
                        <Grid x:Name="ComposerStack" MaxWidth="760" HorizontalAlignment="Center">
                        <!-- The solid lower edge that makes the composer read as a floating
                             plate instead of a flat bar. It carries no meaning, so it is
                             dropped in high contrast along with the rest of the elevation. -->
                        <Border x:Name="ComposerPlateEdge" VerticalAlignment="Bottom" Margin="7,0,7,0"
                                Height="26" CornerRadius="{StaticResource MayasabaRadiusComposer}"
                                Background="{ThemeResource MayasabaPlateEdgeBrush}"/>
                        <Border x:Name="ComposerPanel"
                                Padding="13" CornerRadius="{StaticResource MayasabaRadiusComposer}"
                                Background="{ThemeResource MayasabaPanelBrush}"
                                BorderBrush="{ThemeResource MayasabaBorderBrush}" BorderThickness="1"
                                AllowDrop="True" DragOver="OnComposerDragOver" Drop="OnComposerDrop">
                            <StackPanel Spacing="9">
                                <TextBox x:Name="ComposerBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="76" MaxHeight="200"
                                         PlaceholderText="Message Mayasaba..."
                                         TextChanged="OnDraftChanged"
                                         PreviewKeyDown="OnComposerKeyDown"
                                         AllowDrop="True" DragOver="OnComposerDragOver" Drop="OnComposerDrop"
                                         AutomationProperties.Name="Chat message"/>
                                <ScrollViewer x:Name="AttachmentChipsScroller" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                                              VerticalScrollMode="Disabled" Visibility="Collapsed"
                                              Margin="0,0,0,2">
                                    <StackPanel x:Name="AttachmentChipsPanel" Orientation="Horizontal" Spacing="8"/>
                                </ScrollViewer>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <Button x:Name="AttachButton" Content="Attach files" IsEnabled="False"
                                                CornerRadius="11" Padding="12,7"
                                                Click="OnAttachFiles"
                                                AutomationProperties.HelpText="Attach up to 50 files (max 100 MiB each, 500 MiB aggregate)."/>
                                        <TextBlock x:Name="ComposerShortcutHint"
                                                   Text="Enter to send · Shift+Enter for newline"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{ThemeResource MayasabaMutedBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="SendButton" Grid.Column="1" Content="Send →"
                                            Style="{StaticResource MayasabaPrimaryAction}"
                                            Click="OnSend"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True"
                 AutomationProperties.LiveSetting="Polite"
                 Severity="Informational" Margin="18,5,18,10"/>
    </Grid>
</Window>

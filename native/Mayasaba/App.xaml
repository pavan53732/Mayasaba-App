<Application
    x:Class="Mayasaba.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MayasabaPanelBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="MayasabaSecondaryBrush" Color="#FFF4F3FA"/>
            <SolidColorBrush x:Key="MayasabaInkBrush" Color="#FF232545"/>
            <SolidColorBrush x:Key="MayasabaMutedBrush" Color="#FF67708D"/>
            <SolidColorBrush x:Key="MayasabaAccentBrush" Color="#FF5A54C8"/>
            <SolidColorBrush x:Key="MayasabaBorderBrush" Color="#FFE5E5F0"/>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MayasabaPanelBrush" Color="#FF202234"/>
            <SolidColorBrush x:Key="MayasabaSecondaryBrush" Color="#FF2A2C42"/>
            <SolidColorBrush x:Key="MayasabaInkBrush" Color="#FFF3F1FF"/>
            <SolidColorBrush x:Key="MayasabaMutedBrush" Color="#FFB8BDD5"/>
            <SolidColorBrush x:Key="MayasabaAccentBrush" Color="#FFBBB4FF"/>
            <SolidColorBrush x:Key="MayasabaBorderBrush" Color="#FF44475E"/>
          </ResourceDictionary>
          <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MayasabaPanelBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaInkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="MayasabaBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Application.Resources>
</Application>

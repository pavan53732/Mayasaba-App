<Application
    x:Class="Mayasaba.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- ==================================================================
             Mayasaba shared visual system.
             One token source for all three screens: shape, rhythm, type scale,
             elevation and motion. Every colour is a theme resource so Windows
             high contrast overrides the whole ramp.
             ================================================================== -->

        <!-- Shape and rhythm tokens are theme-independent. -->
        <CornerRadius x:Key="MayasabaRadiusPanel">18</CornerRadius>
        <CornerRadius x:Key="MayasabaRadiusControl">11</CornerRadius>
        <CornerRadius x:Key="MayasabaRadiusComposer">17</CornerRadius>
        <CornerRadius x:Key="MayasabaRadiusChip">14</CornerRadius>
        <CornerRadius x:Key="MayasabaRadiusMonogram">10</CornerRadius>

        <!-- 4/8/12/16/24/32 spacing scale. -->
        <x:Double x:Key="MayasabaSpace1">4</x:Double>
        <x:Double x:Key="MayasabaSpace2">8</x:Double>
        <x:Double x:Key="MayasabaSpace3">12</x:Double>
        <x:Double x:Key="MayasabaSpace4">16</x:Double>
        <x:Double x:Key="MayasabaSpace6">24</x:Double>
        <x:Double x:Key="MayasabaSpace8">32</x:Double>

        <!-- Brand mark sizes. The dimensional hero is the strongest 3D expression
             and is confined to the Welcome screen and the empty-Chat hero. -->
        <x:Double x:Key="MayasabaBrandMarkHeroSize">138</x:Double>
        <x:Double x:Key="MayasabaBrandMarkOnboardingSize">92</x:Double>
        <x:Double x:Key="MayasabaBrandMarkTitleSize">31</x:Double>
        <x:Double x:Key="MayasabaBrandMarkChatHeroSize">76</x:Double>

        <!-- Logical type scale. Windows text scaling still takes precedence: every
             text style below sets only a base size and lets the platform scale it. -->
        <x:Double x:Key="MayasabaFontHero">40</x:Double>
        <x:Double x:Key="MayasabaFontScreenTitle">30</x:Double>
        <x:Double x:Key="MayasabaFontSection">19</x:Double>
        <x:Double x:Key="MayasabaFontConversation">15.5</x:Double>
        <x:Double x:Key="MayasabaFontBody">14</x:Double>
        <x:Double x:Key="MayasabaFontMeta">12.5</x:Double>
        <x:Double x:Key="MayasabaFontMicro">11.5</x:Double>

        <!-- Prose measure: roughly 60-80 characters per line on a wide window. -->
        <x:Double x:Key="MayasabaProseMeasure">720</x:Double>
        <x:Double x:Key="MayasabaWideMeasure">880</x:Double>

        <!-- Motion tokens live in Motion.h (MotionTokens), including the ambient
             Levitate, Glow and Orbit periods. MotionController builds those loops
             from the tokens, so no duration is duplicated in XAML. -->

        <!-- Elevation. Two levels: resting content and raised overlays.
             High contrast drops both (see the HighContrast dictionary). -->
        <x:Double x:Key="MayasabaElevationResting">8</x:Double>
        <x:Double x:Key="MayasabaElevationRaised">32</x:Double>
        <x:Double x:Key="MayasabaElevationHero">24</x:Double>

        <!-- Reusable text styles. Segoe UI Variable for product text; Cascadia Mono
             is reserved for code, paths and technical identities. -->
        <Style x:Key="MayasabaHeroText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontHero}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaInkBrush}"/>
        </Style>
        <Style x:Key="MayasabaScreenTitleText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontScreenTitle}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaInkBrush}"/>
        </Style>
        <Style x:Key="MayasabaSectionText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontSection}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaInkBrush}"/>
        </Style>
        <Style x:Key="MayasabaBodyText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontBody}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaInkBrush}"/>
        </Style>
        <Style x:Key="MayasabaConversationText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontConversation}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="IsTextSelectionEnabled" Value="True"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaInkBrush}"/>
        </Style>
        <Style x:Key="MayasabaMetaText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontMeta}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaMutedBrush}"/>
        </Style>
        <Style x:Key="MayasabaMicroText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontMicro}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaMutedBrush}"/>
        </Style>
        <!-- Paths, hashes and technical identities: monospace, inspectable, selectable. -->
        <Style x:Key="MayasabaTechnicalText" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Cascadia Mono"/>
          <Setter Property="FontSize" Value="{StaticResource MayasabaFontMicro}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="IsTextSelectionEnabled" Value="True"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaMutedBrush}"/>
        </Style>

        <!-- Surfaces. The quiet background plane, the readable content plane and the
             raised temporary-details plane. -->
        <Style x:Key="MayasabaCardSurface" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource MayasabaPanelBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource MayasabaBorderBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="{StaticResource MayasabaRadiusPanel}"/>
          <Setter Property="Padding" Value="{StaticResource MayasabaSpace4}"/>
        </Style>
        <Style x:Key="MayasabaSecondarySurface" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource MayasabaSecondaryBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource MayasabaBorderBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="{StaticResource MayasabaRadiusChip}"/>
        </Style>

        <!-- Primary action: the permitted brand action gradient. -->
        <Style x:Key="MayasabaPrimaryAction" TargetType="Button">
          <Setter Property="Background" Value="{ThemeResource MayasabaActionGradientBrush}"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaOnActionBrush}"/>
          <Setter Property="CornerRadius" Value="{StaticResource MayasabaRadiusControl}"/>
          <Setter Property="Padding" Value="20,10"/>
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MayasabaSecondaryAction" TargetType="Button">
          <Setter Property="Background" Value="{ThemeResource MayasabaSecondaryBrush}"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaInkBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource MayasabaBorderBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="{StaticResource MayasabaRadiusControl}"/>
          <Setter Property="Padding" Value="16,10"/>
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        </Style>
        <Style x:Key="MayasabaQuietAction" TargetType="Button">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{ThemeResource MayasabaInkBrush}"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="{StaticResource MayasabaRadiusControl}"/>
          <Setter Property="Padding" Value="12,8"/>
          <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        </Style>

        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MayasabaCanvasBrush" Color="#FFF3F4F8"/>
            <SolidColorBrush x:Key="MayasabaWindowBrush" Color="#FFFAFBFE"/>
            <SolidColorBrush x:Key="MayasabaPanelBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="MayasabaSecondaryBrush" Color="#FFF5F6FB"/>
            <SolidColorBrush x:Key="MayasabaInkBrush" Color="#FF1D2440"/>
            <SolidColorBrush x:Key="MayasabaMutedBrush" Color="#FF64708C"/>
            <SolidColorBrush x:Key="MayasabaSoftBrush" Color="#FF8993AA"/>
            <SolidColorBrush x:Key="MayasabaBorderBrush" Color="#FFE3E6EF"/>
            <SolidColorBrush x:Key="MayasabaLineBrush" Color="#FFECEEF4"/>
            <SolidColorBrush x:Key="MayasabaBrandBrush" Color="#FF5957C7"/>
            <SolidColorBrush x:Key="MayasabaBrandStrongBrush" Color="#FF4542B4"/>
            <SolidColorBrush x:Key="MayasabaBrandQuietBrush" Color="#FFEEEEFE"/>
            <SolidColorBrush x:Key="MayasabaVioletBrush" Color="#FF9273EE"/>
            <SolidColorBrush x:Key="MayasabaMintBrush" Color="#FF2EA891"/>
            <SolidColorBrush x:Key="MayasabaAmberBrush" Color="#FFBB751E"/>
            <SolidColorBrush x:Key="MayasabaDangerBrush" Color="#FFC75568"/>
            <SolidColorBrush x:Key="MayasabaBlueBrush" Color="#FF3970B3"/>
            <SolidColorBrush x:Key="MayasabaHermesMonogramBrush" Color="#FFEEEAFF"/>
            <SolidColorBrush x:Key="MayasabaHermesInkBrush" Color="#FF6854BC"/>
            <SolidColorBrush x:Key="MayasabaKiloMonogramBrush" Color="#FFDFF8F3"/>
            <SolidColorBrush x:Key="MayasabaKiloInkBrush" Color="#FF17816D"/>
            <SolidColorBrush x:Key="MayasabaClaudeMonogramBrush" Color="#FFFFF0E2"/>
            <SolidColorBrush x:Key="MayasabaClaudeInkBrush" Color="#FFB36B2C"/>
            <!-- On-action ink is fixed white over the brand action gradient in both
                 standard themes; high contrast replaces the gradient with a system
                 brush and switches this to the system highlight-text colour. -->
            <SolidColorBrush x:Key="MayasabaOnActionBrush" Color="#FFFFFFFF"/>
            <!-- Agent reply surface: a slightly raised reading plane, distinct from
                 the user's brand-tinted bubble. -->
            <SolidColorBrush x:Key="MayasabaReplySurfaceBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="MayasabaReplyEdgeBrush" Color="#FF5957C7"/>
            <SolidColorBrush x:Key="MayasabaCodeSurfaceBrush" Color="#FFF5F6FB"/>
            <!-- Layered-edge tints for the dimensional brand mark. -->
            <SolidColorBrush x:Key="MayasabaDepthEdgeBrush" Color="#FF4542B4"/>
            <!-- Brand gradient: the logo mark (CSS 145deg Brand -> Violet). -->
            <LinearGradientBrush x:Key="MayasabaBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF5957C7" Offset="0"/>
              <GradientStop Color="#FF9273EE" Offset="1"/>
            </LinearGradientBrush>
            <!-- Action gradient: primary button (CSS 115deg #5651C8 -> #766CE6). -->
            <LinearGradientBrush x:Key="MayasabaActionGradientBrush" StartPoint="0,0.15" EndPoint="1,0.85">
              <GradientStop Color="#FF5651C8" Offset="0"/>
              <GradientStop Color="#FF766CE6" Offset="1"/>
            </LinearGradientBrush>
            <!-- Ambient hero glow. Brand at ~14% alpha, never behind timeline content. -->
            <RadialGradientBrush x:Key="MayasabaAmbientGlowBrush" MappingMode="RelativeToBoundingBox"
                                 Center="0.5,0.12" GradientOrigin="0.5,0.12" RadiusX="0.55" RadiusY="0.65">
              <GradientStop Color="#249273EE" Offset="0"/>
              <GradientStop Color="#009273EE" Offset="1"/>
            </RadialGradientBrush>
            <!-- Hero-only headline accent span. Never behind body text. -->
            <LinearGradientBrush x:Key="MayasabaHeadlineAccentBrush" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF5957C7" Offset="0"/>
              <GradientStop Color="#FF9273EE" Offset="1"/>
            </LinearGradientBrush>
            <!-- Contact shadow: the resting cue under a lifted mark. Decorative only,
                 removed in high contrast, and never under reading text. -->
            <RadialGradientBrush x:Key="MayasabaContactShadowBrush" MappingMode="RelativeToBoundingBox"
                                 Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
              <GradientStop Color="#3D25284F" Offset="0"/>
              <GradientStop Color="#0025284F" Offset="1"/>
            </RadialGradientBrush>
            <!-- The solid lower edge of a raised plate (composer, project rows).
                 It reads as thickness under the surface rather than a glow. -->
            <SolidColorBrush x:Key="MayasabaPlateEdgeBrush" Color="#FFE1E3EF"/>
            <!-- Restrained top-light on the sculpted brand face. -->
            <LinearGradientBrush x:Key="MayasabaFaceLightBrush" StartPoint="0,0" EndPoint="0.45,1">
              <GradientStop Color="#59FFFFFF" Offset="0"/>
              <GradientStop Color="#0AFFFFFF" Offset="0.55"/>
              <GradientStop Color="#1F382D7E" Offset="1"/>
            </LinearGradientBrush>
          </ResourceDictionary>

          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MayasabaCanvasBrush" Color="#FF111318"/>
            <SolidColorBrush x:Key="MayasabaWindowBrush" Color="#FF161922"/>
            <SolidColorBrush x:Key="MayasabaPanelBrush" Color="#FF1E2230"/>
            <SolidColorBrush x:Key="MayasabaSecondaryBrush" Color="#FF252A3A"/>
            <SolidColorBrush x:Key="MayasabaInkBrush" Color="#FFF0F2FF"/>
            <SolidColorBrush x:Key="MayasabaMutedBrush" Color="#FFA5ADC6"/>
            <SolidColorBrush x:Key="MayasabaSoftBrush" Color="#FF7F8AA5"/>
            <SolidColorBrush x:Key="MayasabaBorderBrush" Color="#FF363C52"/>
            <SolidColorBrush x:Key="MayasabaLineBrush" Color="#FF30364A"/>
            <SolidColorBrush x:Key="MayasabaBrandBrush" Color="#FFA5A1FF"/>
            <SolidColorBrush x:Key="MayasabaBrandStrongBrush" Color="#FFC4C0FF"/>
            <SolidColorBrush x:Key="MayasabaBrandQuietBrush" Color="#FF343454"/>
            <SolidColorBrush x:Key="MayasabaVioletBrush" Color="#FFBBA0FF"/>
            <SolidColorBrush x:Key="MayasabaMintBrush" Color="#FF69DBC3"/>
            <SolidColorBrush x:Key="MayasabaAmberBrush" Color="#FFF0B565"/>
            <SolidColorBrush x:Key="MayasabaDangerBrush" Color="#FFFA94A1"/>
            <SolidColorBrush x:Key="MayasabaBlueBrush" Color="#FF90BCF9"/>
            <SolidColorBrush x:Key="MayasabaHermesMonogramBrush" Color="#FF2E2B4D"/>
            <SolidColorBrush x:Key="MayasabaHermesInkBrush" Color="#FFB9AEFF"/>
            <SolidColorBrush x:Key="MayasabaKiloMonogramBrush" Color="#FF183C38"/>
            <SolidColorBrush x:Key="MayasabaKiloInkBrush" Color="#FF69DBC3"/>
            <SolidColorBrush x:Key="MayasabaClaudeMonogramBrush" Color="#FF463522"/>
            <SolidColorBrush x:Key="MayasabaClaudeInkBrush" Color="#FFF0B565"/>
            <SolidColorBrush x:Key="MayasabaOnActionBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="MayasabaReplySurfaceBrush" Color="#FF1E2230"/>
            <SolidColorBrush x:Key="MayasabaReplyEdgeBrush" Color="#FFA5A1FF"/>
            <SolidColorBrush x:Key="MayasabaCodeSurfaceBrush" Color="#FF252A3A"/>
            <SolidColorBrush x:Key="MayasabaDepthEdgeBrush" Color="#FF3A3560"/>
            <LinearGradientBrush x:Key="MayasabaBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF5853C9" Offset="0"/>
              <GradientStop Color="#FFAB88E8" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="MayasabaActionGradientBrush" StartPoint="0,0.15" EndPoint="1,0.85">
              <GradientStop Color="#FF5B56C7" Offset="0"/>
              <GradientStop Color="#FF7E74E8" Offset="1"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="MayasabaAmbientGlowBrush" MappingMode="RelativeToBoundingBox"
                                 Center="0.5,0.12" GradientOrigin="0.5,0.12" RadiusX="0.55" RadiusY="0.65">
              <GradientStop Color="#2E9E8FFF" Offset="0"/>
              <GradientStop Color="#009E8FFF" Offset="1"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="MayasabaHeadlineAccentBrush" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FFA5A1FF" Offset="0"/>
              <GradientStop Color="#FFBBA0FF" Offset="1"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="MayasabaContactShadowBrush" MappingMode="RelativeToBoundingBox"
                                 Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
              <GradientStop Color="#73000000" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="MayasabaPlateEdgeBrush" Color="#FF2D3244"/>
            <LinearGradientBrush x:Key="MayasabaFaceLightBrush" StartPoint="0,0" EndPoint="0.45,1">
              <GradientStop Color="#4DFFFFFF" Offset="0"/>
              <GradientStop Color="#00FFFFFF" Offset="0.55"/>
              <GradientStop Color="#26000000" Offset="1"/>
            </LinearGradientBrush>
          </ResourceDictionary>

          <!-- High contrast: system colours only. Every gradient collapses to a solid
               system brush and elevation is dropped, so no meaning depends on colour.
               Decorative depth and ambient motion are also disabled at runtime. -->
          <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MayasabaCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaWindowBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaPanelBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaInkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaSoftBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaLineBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaBrandBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="MayasabaBrandStrongBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="MayasabaBrandQuietBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaVioletBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaMintBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaAmberBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaBlueBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaHermesMonogramBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaHermesInkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaKiloMonogramBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaKiloInkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaClaudeMonogramBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaClaudeInkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaOnActionBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="MayasabaReplySurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaReplyEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaCodeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaDepthEdgeBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaBrandGradientBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="MayasabaActionGradientBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="MayasabaAmbientGlowBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaHeadlineAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MayasabaContactShadowBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaPlateEdgeBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MayasabaFaceLightBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Application.Resources>
</Application>

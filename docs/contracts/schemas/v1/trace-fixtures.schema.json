{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/contracts/v1/trace-fixtures.schema.json",
  "title": "Mayasaba v1 adversarial fixture index",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status", "fixtures"],
  "properties": {
    "contract_version": { "$ref": "core.schema.json#/$defs/ContractVersion" },
    "status": { "const": "DOCUMENTATION_EXPECTATION_NOT_EXECUTED_TEST" },
    "fixtures": {
      "type": "array",
      "minItems": 52,
      "maxItems": 52,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Fixture" }
    }
  },
  "$defs": {
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected", "contract", "boundary_result", "physical_outcome", "operational_disposition"],
      "properties": {
        "id": { "oneOf": [{ "pattern": "^T(0[1-9]|1[0-9]|2[0-2])$" }, { "pattern": "^F(0[1-9]|[12][0-9]|30)$" }] },
        "expected": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "contract": { "type": "string", "minLength": 2, "maxLength": 128 },
        "boundary_result": { "enum": ["COMMITTED", "REFUSED", "DUPLICATE", "UNKNOWN"] },
        "physical_outcome": { "$ref": "core.schema.json#/$defs/PhysicalOutcome" },
        "operational_disposition": { "$ref": "core.schema.json#/$defs/OperationalDisposition" },
        "validation_verdict": { "$ref": "core.schema.json#/$defs/AcceptanceVerdict" },
        "error_code": { "$ref": "core.schema.json#/$defs/ErrorCode" }
      },
      "allOf": [
        { "if": { "properties": { "boundary_result": { "enum": ["REFUSED", "UNKNOWN"] } }, "required": ["boundary_result"] }, "then": { "required": ["error_code"] } },
        { "if": { "properties": { "boundary_result": { "enum": ["COMMITTED", "DUPLICATE"] } }, "required": ["boundary_result"] }, "then": { "properties": { "error_code": false } } }
      ]
    }
  }
}
